# Local Supabase database (supabase start); copy to .env.local, never commit real keys.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Next.js telemetry off. .env.local covers next build and the next dev server,
# but the next dev parent process never loads .env files, so also set it in the
# shell: $env:NEXT_TELEMETRY_DISABLED=1
NEXT_TELEMETRY_DISABLED=1
